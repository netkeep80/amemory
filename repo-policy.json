{
  "policy_format_version": "0.3.0",
  "repository_kind": "tooling",
  "enforcement": {
    "mode": "advisory"
  },
  "paths": {
    "forbidden": [
      "legacy/**",
      "archive/**",
      "old/**",
      "deprecated/**",
      "*.bak",
      "*.tmp",
      "*.orig"
    ],
    "canonical_docs": [
      "README.md"
    ],
    "governance_paths": [
      "repo-policy.json",
      ".github/workflows/repo-guard.yml",
      ".github/workflows/branch-hygiene.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE/change-contract.yml",
      "contracts/amemory-contract-v0.1.json",
      "contracts/amemory-conformance-v0.1.json",
      "contracts/upstream/mts-v0.13.lock.json",
      "contracts/upstream/mts-v0.13-requirements.json",
      "scripts/sync-mts-requirements.mjs",
      "scripts/test-mts-upstream-import.mjs",
      ".github/workflows/mts-upstream-check.yml",
      ".github/workflows/browser-differential-check.yml",
      "experiments/browser-accelerator/web/differential.mjs",
      "experiments/browser-accelerator/tests/differential.test.mjs",
      ".github/workflows/browser-canonicalization-check.yml",
      "experiments/browser-accelerator/web/canonicalization.mjs",
      "experiments/browser-accelerator/tests/canonicalization.test.mjs",
      ".github/workflows/browser-state-store-check.yml",
      "experiments/browser-accelerator/web/state-store.mjs",
      "experiments/browser-accelerator/tests/state-store.test.mjs",
      ".github/workflows/browser-anum-boundary-check.yml",
      "experiments/browser-accelerator/web/anum-boundary.mjs",
      "experiments/browser-accelerator/tests/anum-boundary.test.mjs",
      ".github/workflows/browser-reaction-check.yml",
      "experiments/browser-accelerator/web/reaction.mjs",
      "experiments/browser-accelerator/tests/reaction.test.mjs"
    ],
    "operational_paths": []
  },
  "diff_rules": {
    "max_new_docs": 4,
    "max_new_files": 30,
    "max_net_added_lines": 4000
  },
  "packs": {
    "repo-guard-workflow": {
      "path": ".github/workflows/repo-guard.yml",
      "sha": "92432809fcddc290080beb51ba151e13a5761869"
    }
  },
  "content_rules": [],
  "cochange_rules": [],
  "cochange_groups": [
    {
      "id": "amemory-contract-conformance",
      "members": [
        "contracts/amemory-contract-v0.1.json",
        "contracts/amemory-conformance-v0.1.json"
      ]
    },
    {
      "id": "mts-upstream-lock-projection",
      "members": [
        "contracts/upstream/mts-v0.13.lock.json",
        "contracts/upstream/mts-v0.13-requirements.json"
      ]
    }
  ]
}
