{
  "policy_format_version": "0.3.0",
  "repository_kind": "tooling",
  "enforcement": {
    "mode": "advisory"
  },
  "paths": {
    "forbidden": [
      "legacy/**",
      "archive/**",
      "old/**",
      "deprecated/**",
      "*.bak",
      "*.tmp",
      "*.orig"
    ],
    "canonical_docs": [
      "README.md"
    ],
    "governance_paths": [
      "repo-policy.json",
      ".github/workflows/repo-guard.yml",
      ".github/workflows/branch-hygiene.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE/change-contract.yml",
      "contracts/amemory-contract-v0.1.json",
      "contracts/amemory-conformance-v0.1.json",
      "contracts/upstream/mts-v0.13.lock.json",
      "contracts/upstream/mts-v0.13-requirements.json",
      "scripts/sync-mts-requirements.mjs",
      "scripts/test-mts-upstream-import.mjs",
      ".github/workflows/mts-upstream-check.yml"
    ],
    "operational_paths": []
  },
  "diff_rules": {
    "max_new_docs": 4,
    "max_new_files": 30,
    "max_net_added_lines": 4000
  },
  "packs": {
    "repo-guard-workflow": {
      "path": ".github/workflows/repo-guard.yml",
      "sha": "37a8d4dd65ac86f683c063dd1e0a6ddb685b2da6"
    }
  },
  "content_rules": [],
  "cochange_rules": [],
  "cochange_groups": [
    {
      "id": "amemory-contract-conformance",
      "members": [
        "contracts/amemory-contract-v0.1.json",
        "contracts/amemory-conformance-v0.1.json"
      ]
    },
    {
      "id": "mts-upstream-lock-projection",
      "members": [
        "contracts/upstream/mts-v0.13.lock.json",
        "contracts/upstream/mts-v0.13-requirements.json"
      ]
    }
  ]
}
