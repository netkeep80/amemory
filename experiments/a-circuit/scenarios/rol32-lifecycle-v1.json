        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x00000801"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "valueMask",
          "expected": "0x00000801"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "undefinedMask",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "preserveMask",
          "expected": "0x000000d4"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 3
        }
      ]
    },
    {
      "runId": "run-6-return-first",
      "inputs": {
        "VALUE": "0x80000001",
        "COUNT": 0
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 16,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x80000001"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "undefinedMask",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "preserveMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 1
        }
      ]
    }
  ],
  "supportedBackends": [
    "optimized-cpu"
  ],
  "oraclePolicy": "FRESH_INSTANCE",
  "invariants": [
