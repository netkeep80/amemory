      "type": "WORD32",
      "description": "Первый беззнаковый 32-битный множитель",
      "default": "0x00000000"
    },
    {
      "key": "B",
      "type": "WORD32",
      "description": "Второй беззнаковый 32-битный множитель",
      "default": "0x00000000"
    }
  ],
  "initialInputs": {
    "A": "0x00000000",
    "B": "0x00000000"
