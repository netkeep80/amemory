{
  "schemaVersion": 1,
  "scenarioId": "radix-memory8-lifecycle",
  "scenarioVersion": "1.0.0",
  "title": "M6A: структурная память Byte8 в одной апамяти",
  "description": "Статическая асеть M6A radix-memory загружается один раз; OFFSET/VALUE публикуются связями Links после загрузки и четыре запуска исполняются через общий Scenario Runner в одной постоянной сессии.",
  "programProfile": {
    "profileId": "a-circuit:memory-radix8",
    "family": "memory",
    "programId": "radix-page8",
    "asetSource": "builtin:a-circuit/memory-radix8"
  },
  "inputSchema": [
    {
      "key": "OFFSET",
      "type": "COUNT8",
      "description": "8-битное смещение в структурной странице памяти",
      "default": 37
    },
    {
      "key": "VALUE",
      "type": "COUNT8",
      "description": "Записываемый байт",
      "default": 171
    }
  ],
  "initialInputs": {
    "OFFSET": 37,
    "VALUE": 171
  },
