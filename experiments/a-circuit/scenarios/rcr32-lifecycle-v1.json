{
  "schemaVersion": 1,
  "scenarioId": "rcr32-lifecycle",
  "scenarioVersion": "1.0.0",
  "title": "RCR32: COUNT8, CF и 33-битное кольцо в одной апамяти",
  "description": "Одна статическая асеть ROTATE-CARRY32 загружается один раз; RCR32 выбирается каноническим профилем, VALUE/COUNT/CF публикуются связями Links для последовательных запусков в одной постоянной сессии.",
  "programProfile": {
    "profileId": "a-circuit:rotate-carry-rcr32",
    "family": "rotate-carry-effect",
    "programId": "rcr32",
    "asetSource": "builtin:a-circuit/rotate-carry32/rcr"
  },
  "inputSchema": [
    {
      "key": "VALUE",
      "type": "WORD32",
      "description": "32-битное значение для RCR32",
      "default": "0x80000001"
    },
    {
      "key": "COUNT",
      "type": "COUNT8",
      "description": "8-битный счётчик; семантика RCR32 использует COUNT & 31",
      "default": 0
    },
    {
      "key": "CF",
      "type": "BIT",
      "description": "Входной флаг переноса, структурный 33-й бит",
      "default": 0
    }
  ],
  "initialInputs": {
    "VALUE": "0x80000001",
    "COUNT": 0,
    "CF": 0
  },
