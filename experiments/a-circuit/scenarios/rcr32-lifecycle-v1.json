          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x80000001"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "undefinedMask",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "preserveMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 1
        }
