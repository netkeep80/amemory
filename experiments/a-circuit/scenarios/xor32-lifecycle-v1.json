{
  "schemaVersion": 1,
  "scenarioId": "xor32-lifecycle",
  "scenarioVersion": "1.0.0",
  "title": "XOR32: четыре запуска в одной A-memory",
  "description": "Один XOR32 Aset загружается один раз; четыре пары 32-битных входов публикуются Links-ами и исполняются в одной persistent Session.",
  "programProfile": {
    "profileId": "a-circuit:logic-xor32",
    "family": "logic-effect",
    "programId": "xor32",
    "asetSource": "builtin:a-circuit/logic-effect/xor32"
  },
  "inputSchema": [
    {
      "key": "A",
      "type": "WORD32",
      "description": "Первый 32-битный вход XOR",
      "default": "0x00000000"
    },
    {
      "key": "B",
      "type": "WORD32",
      "description": "Второй 32-битный вход XOR",
      "default": "0xffffffff"
    }
  ],
  "initialInputs": {
    "A": "0x00000000",
    "B": "0xffffffff"
  },
  "runSequence": [
    {
      "runId": "run-1-zero-ones",
      "inputs": {
        "A": "0x00000000",
        "B": "0xffffffff"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 512,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0xffffffff"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 147
        }
      ]
    },
    {
      "runId": "run-2-complement",
      "inputs": {
        "A": "0xaaaaaaaa",
        "B": "0x55555555"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 512,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0xffffffff"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 147
        }
      ]
    },
    {
      "runId": "run-3-pattern",
      "inputs": {
        "A": "0x12345678",
        "B": "0x0f0f00ff"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 512,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x1d3b5687"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 147
        }
      ]
    },
    {
      "runId": "run-4-return-first",
      "inputs": {
        "A": "0x00000000",
        "B": "0xffffffff"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 512,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0xffffffff"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 147
        }
      ]
    }
  ],
  "supportedBackends": [
    "optimized-cpu"
  ],
  "oraclePolicy": "FRESH_INSTANCE",
  "invariants": [
    "prepare-once",
    "load-once",
    "same-session",
    "link-only-reconfiguration",
    "return-to-first-configuration"
  ],
  "observationLevel": "PROFILE",
  "profilingPolicy": "FULL",
  "visualizationProfile": "engineering"
}
