{
  "schemaVersion": 1,
  "scenarioId": "add32-lifecycle",
  "scenarioVersion": "1.0.0",
  "title": "ADD32: граничные случаи в одной апамяти",
  "description": "Одна асеть ADD32 загружается один раз; четыре пары 32-битных входов публикуются связями Links и исполняются в одной постоянной сессии с проверкой результата и EFLAGS.",
  "programProfile": {
    "profileId": "a-circuit:arithmetic-add32",
    "family": "arithmetic-effect",
    "programId": "add32",
    "asetSource": "builtin:a-circuit/arithmetic-effect/add32"
  },
  "inputSchema": [
    {
      "key": "A",
      "type": "WORD32",
      "description": "Первое 32-битное слагаемое",
      "default": "0x00000000"
    },
    {
      "key": "B",
      "type": "WORD32",
      "description": "Второе 32-битное слагаемое",
      "default": "0x00000000"
    }
  ],
  "initialInputs": {
    "A": "0x00000000",
    "B": "0x00000000"
  },
  "runSequence": [
    {
      "runId": "run-1-zero",
      "inputs": {
        "A": "0x00000000",
        "B": "0x00000000"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 1024,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "valueMask",
          "expected": "0x00000044"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 609
        }
      ]
    },
    {
      "runId": "run-2-carry",
      "inputs": {
        "A": "0xffffffff",
        "B": "0x00000001"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 1024,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "valueMask",
          "expected": "0x00000055"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 609
        }
      ]
    },
    {
      "runId": "run-3-overflow",
      "inputs": {
        "A": "0x7fffffff",
        "B": "0x00000001"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 1024,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x80000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "valueMask",
          "expected": "0x00000894"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 609
        }
      ]
    },
    {
      "runId": "run-4-return-first",
      "inputs": {
        "A": "0x00000000",
        "B": "0x00000000"
      },
      "executionMode": "TO_QUIESCENCE",
      "maxReactions": 1024,
      "assertions": [
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "value",
          "expected": "0x00000000"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "definedMask",
          "expected": "0x000008d5"
        },
        {
          "kind": "RESULT_FIELD_EQUALS",
          "field": "valueMask",
          "expected": "0x00000044"
        },
        {
          "kind": "QUIESCENT_EQUALS",
          "expected": true
        },
        {
          "kind": "REACTION_COUNT_EQUALS",
          "expected": 609
        }
      ]
    }
  ],
  "supportedBackends": [
    "optimized-cpu"
  ],
  "oraclePolicy": "FRESH_INSTANCE",
  "invariants": [
    "prepare-once",
    "load-once",
    "same-session",
    "link-only-reconfiguration",
    "return-to-first-configuration"
  ],
  "observationLevel": "PROFILE",
  "profilingPolicy": "FULL",
  "visualizationProfile": "engineering"
}
